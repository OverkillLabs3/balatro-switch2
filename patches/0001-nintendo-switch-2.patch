+
 void Mouse::getPosition(double &x, double &y) const
 {
 	int mx, my;
 	SDL_GetMouseState(&mx, &my);
+#ifdef __SWITCH__
+	// SDL knows nothing of the pointer and the touches we feed it, so the game gets the last position we saw
