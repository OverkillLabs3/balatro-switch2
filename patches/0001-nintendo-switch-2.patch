 		love.filesystem._setAndroidSaveExternal(c.externalstorage)
 		love.filesystem.setIdentity(c.identity or love.filesystem.getIdentity(), c.appendidentity)
 		if love.filesystem.getInfo("main.lua") then
+			if love.graphics then
+				-- Switch 2: the console draws no mouse cursor, so one is drawn where the game wants it.
+				-- Clicking both sticks together turns the FPS counter on and off; the choice is kept in the save folder.
+				local present = love.graphics.present
+				local font
+				local showFps = love.filesystem.getInfo("fps_on") ~= nil
+				local held = false
+				love.graphics.present = function(...)
+					if love.graphics.isActive() then
+						local both = false
+						if love.joystick then
+							for _, joystick in ipairs(love.joystick.getJoysticks()) do
+								if joystick:isGamepad() and joystick:isGamepadDown("leftstick") and joystick:isGamepadDown("rightstick") then
+									both = true
+								end
+							end
+						end
+						if both and not held then
+							showFps = not showFps
+							if showFps then love.filesystem.write("fps_on", "") else love.filesystem.remove("fps_on") end
+						end
+						held = both
+
+						love.graphics.push("all")
+						love.graphics.origin()
+						if showFps then
+							font = font or love.graphics.newFont(22)
+							love.graphics.setFont(font)
+							love.graphics.setColor(0, 0, 0, 0.7)
+							love.graphics.print(love.timer.getFPS() .. " FPS", 13, 11)
+							love.graphics.setColor(1, 1, 0.2, 1)
+							love.graphics.print(love.timer.getFPS() .. " FPS", 12, 10)
+						end
+						if love.mouse and love.mouse.isVisible() then
+							local mx, my = love.mouse.getPosition()
+							love.graphics.translate(mx, my)
+							love.graphics.scale(1.5)
+							local arrow = {0, 0, 0, 17, 4.5, 13, 8, 21, 11, 19.5, 7.5, 12, 13, 12}
+							love.graphics.setColor(0, 0, 0, 1)
+							love.graphics.setLineWidth(2.5)
+							love.graphics.polygon("line", arrow)
+							love.graphics.setColor(1, 1, 1, 1)
+							love.graphics.polygon("fill", arrow)
+						end
+						love.graphics.pop()
+					end
+					return present(...)
+				end
+			end
 			require("main")
 		end
 	end
